# Copy this file to ".env" and fill in the value.
#
# The email signup form POSTs the subscriber's email (as JSON) to this URL.
# It should point at a small Cloudflare Worker (built separately) that forwards
# the email to your email service provider (Mailchimp, Buttondown, ConvertKit, etc.)
# so the list is actually sendable later.
#
# The Worker that handles this lives in ./worker (deploy it, then paste its URL
# here). See worker/README.md.
#
# Must be prefixed with PUBLIC_ so Astro exposes it to the browser at build time.
PUBLIC_SIGNUP_ENDPOINT=https://sugar-mama-signup.your-subdomain.workers.dev
